    <worksheet name='03 Where people are cared for'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='13'>Where older Australians are cared for, 2017-18 to 2024-25</run><run>Æ&#10;</run><run fontcolor='#52514e' fontname='Tableau Book' fontsize='10' italic='true'>2021-22: Home Care Packages overtook permanent residential care.</run>
