              <tooltip column='[federated.0mekko000000000000000000].[avg:programme_share_pct:qk]' />
              <tooltip column='[federated.0mekko000000000000000000].[avg:population_65plus_000:qk]' />
              <tooltip column='[federated.0mekko000000000000000000].[avg:rate_per_1000:qk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.0mekko000000000000000000].[none:state:nk]>]]></run>
