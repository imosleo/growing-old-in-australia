    <worksheet name='09 Where the extra billions went'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Tableau Medium' fontsize='13'>Where the extra $19.5 billion went, 2014-15 to 2024-25 (real dollars)</run><run>Æ&#10;</run><run fontcolor='#52514e' fontname='Tableau Book' fontsize='10' italic='true'>Residential care added $10.9bn, home care $7.7bn. Total reaches $39.8bn.</run>
          </formatted-text>
        </title>
      </layout-options>
