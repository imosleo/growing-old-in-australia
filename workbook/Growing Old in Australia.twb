                <run bold='true'><![CDATA[<[federated.0mekko000000000000000000].[none:programme:nk]>]]></run>
                <run>Æ&#10;</run>
                <run bold='true'><![CDATA[<[federated.0mekko000000000000000000].[avg:programme_share_pct:qk]>]]></run>
                <run>% of the state&apos;s aged care use (</run>
                <run bold='true'><![CDATA[<[federated.0mekko000000000000000000].[avg:rate_per_1000:qk]>]]></run>
                <run> per 1,000).</run>
                <run>Æ&#10;</run>
                <run bold='true'><![CDATA[<[federated.0mekko000000000000000000].[avg:population_65plus_000:qk]>]]></run>
                <run> thousand residents aged 65 and over.</run>
              </formatted-text>
            </customized-tooltip>
