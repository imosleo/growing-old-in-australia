            <column-instance column='[running_total_m]' derivation='Sum' name='[sum:running_total_m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[amount_m]' derivation='Sum' name='[sum:amount_m:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_wf_size]' derivation='Sum' name='[sum:Calculation_wf_size:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='computed' column='[federated.0wfall000000000000000000].[none:label:nk]' direction='ASC' using='[federated.0wfall000000000000000000].[sum:step:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='table'>
            <format attr='background-color' value='#ffffff' />
          </style-rule>
          <style-rule element='header'>
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
